# ===========================
# YogduOJ Monorepo .gitignore
# ===========================

# ---------- OS generated files ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------- IDE / Editor ----------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains (GoLand, WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]

# Sublime Text
*.sublime-project
*.sublime-workspace

# ---------- Go ----------
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of go coverage tool
*.out
*.prof

# Go workspace file
go.work
go.work.sum

# Vendor directory (keep or ignore based on preference)
# vendor/

# Dependency directories
vendor/

# Go build cache
.cache/

# ---------- Node.js / Vue / Frontend ----------
# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul
coverage/
*.lcov
.nyc_output/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn
.yarn-integrity
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# pnpm
pnpm-lock.yaml

# dotenv environment variables file
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Parcel
.parcel-cache/

# TypeScript
*.tsbuildinfo

# Vue specific
.vite/
vite.config.*.timestamp*

# ---------- Docker ----------
docker-compose.override.yml
.docker/

# ---------- Database ----------
*.sql
*.sqlite
*.sqlite3
*.db

# ---------- Secrets / Config ----------
*.pem
*.key
*.crt
*.csr
*.pub
config/local.yaml
config/*.local.yaml
secrets/
*.secret

# ---------- Test / Temp ----------
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ---------- Judge / Sandbox ----------
judge/testdata/
judge/bin/
judge/tmp/
judge/workspace/

# ---------- Uploads / Media ----------
uploads/
static/uploads/

# ---------- Misc ----------
*.patch
*.diff
tags
TAGS
*.tags
